{
  "name": "digital-banking-system",
  "version": "1.0.0",
  "description": "Core backend for a digital bank - customer onboarding (BVN/NIN), account management and core banking operations on top of the NibssByPhoenix API.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "onboard": "node scripts/onboard-fintech.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "banking",
    "express",
    "mongodb",
    "nibss",
    "fintech"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "validator": "^13.15.35",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
