# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Bank identity - the name you register with NibssByPhoenix
# ---------------------------------------------------------------------------
BANK_NAME=Phoenix Trust Bank
BANK_CODE=000001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/digital_banking
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/digital_banking_test

# ---------------------------------------------------------------------------
# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# NibssByPhoenix provider
# Run `npm run onboard` once; the credentials arrive by email.
# ---------------------------------------------------------------------------
NIBSS_BASE_URL=https://nibssbyphoenix.onrender.com
NIBSS_API_KEY=
NIBSS_API_SECRET=
NIBSS_TIMEOUT_MS=30000
NIBSS_MAX_RETRIES=3
NIBSS_TOKEN_SKEW_SECONDS=60

# ---------------------------------------------------------------------------
# Business rules (amounts in KOBO)
# ---------------------------------------------------------------------------
OPENING_BALANCE_KOBO=1500000
MAX_ACCOUNTS_PER_CUSTOMER=1
MIN_TRANSFER_KOBO=100
MAX_TRANSFER_KOBO=100000000
NAME_ENQUIRY_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Protection
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=*
